NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_VESTA_VAULT_ACCOUNT_ID=dev-7706-30240.cipher22.testnet
# POST /api/run-now loads agent/.env if present, then defaults:
# VESTA_OWNER_ACCOUNT_ID=cipher22.testnet, vault from NEXT_PUBLIC_VESTA_VAULT_ACCOUNT_ID.
# Agent key: agent/.agent-key.json or VESTA_AGENT_PRIVATE_KEY in agent/.env / shell env.

# Server-side path to agent log (optional; defaults to ../agent/data/runs.json)
# VESTA_RUNS_FILE=/absolute/path/to/runs.json